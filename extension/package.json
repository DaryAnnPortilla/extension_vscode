{
  "name": "code-analyzer-extension",
  "displayName": "Code Analyzer",
  "description": "Analiza cambios en el código para detectar comportamientos abruptos en entornos educativos",
  "version": "3.2.0",
  "publisher": "tu-publisher",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Education",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onCommand:codeAnalyzer.startMonitoring",
    "onCommand:codeAnalyzer.stopMonitoring",
    "onCommand:codeAnalyzer.showScore",
    "onCommand:codeAnalyzer.showDetailedReport",
    "onCommand:codeAnalyzer.generateFinalReport",
    "onCommand:codeAnalyzer.generatePdfReport",
    "onCommand:codeAnalyzer.resetScores",
    "onCommand:codeAnalyzer.verifyStatus",
    "onCommand:codeAnalyzer.deactivateExtension"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeAnalyzer.startMonitoring",
        "title": "Iniciar Monitoreo",
        "category": "Code Analyzer"
      },
      {
        "command": "codeAnalyzer.stopMonitoring",
        "title": "Detener Monitoreo",
        "category": "Code Analyzer"
      },
      {
        "command": "codeAnalyzer.showScore",
        "title": "Mostrar Puntuación",
        "category": "Code Analyzer"
      },
      {
        "command": "codeAnalyzer.showDetailedReport",
        "title": "Mostrar Reporte Detallado",
        "category": "Code Analyzer"
      },
      {
        "command": "codeAnalyzer.generateFinalReport",
        "title": "Generar Reporte Final",
        "category": "Code Analyzer"
      },
      {
        "command": "codeAnalyzer.generatePdfReport",
        "title": "Generar Reporte PDF",
        "category": "Code Analyzer"
      },
      {
        "command": "codeAnalyzer.resetScores",
        "title": "Reiniciar Puntuaciones",
        "category": "Code Analyzer"
      },
      {
        "command": "codeAnalyzer.verifyStatus",
        "title": "Verificar Estado",
        "category": "Code Analyzer"
      },
      {
        "command": "codeAnalyzer.deactivateExtension",
        "title": "Desactivar Extensión",
        "category": "Code Analyzer"
      },
      {
        "command": "codeAnalyzer.interceptPaste",
        "title": "Intercept Paste",
        "category": "Code Analyzer"
      },
      {
        "command": "codeAnalyzer.interceptCopy",
        "title": "Intercept Copy",
        "category": "Code Analyzer"
      },
      {
        "command": "codeAnalyzer.interceptCut",
        "title": "Intercept Cut",
        "category": "Code Analyzer"
      },
      {
        "command": "codeAnalyzer.acceptSuggestionTab",
        "title": "Accept Suggestion (Tab)",
        "category": "Code Analyzer"
      },
      {
        "command": "codeAnalyzer.acceptSuggestionEnter",
        "title": "Accept Suggestion (Enter)",
        "category": "Code Analyzer"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codeAnalyzer.interceptPaste",
          "when": "false"
        },
        {
          "command": "codeAnalyzer.interceptCopy",
          "when": "false"
        },
        {
          "command": "codeAnalyzer.interceptCut",
          "when": "false"
        },
        {
          "command": "codeAnalyzer.acceptSuggestionTab",
          "when": "false"
        },
        {
          "command": "codeAnalyzer.acceptSuggestionEnter",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Code Analyzer",
      "properties": {
        "codeAnalyzer.maxScore": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 100,
          "description": "Puntuación máxima inicial"
        },
        "codeAnalyzer.penaltyAmount": {
          "type": "number",
          "default": 0.25,
          "minimum": 0.05,
          "maximum": 5,
          "description": "Puntos a restar por penalización"
        },
        "codeAnalyzer.maxWarnings": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "description": "Número máximo de advertencias antes de penalizar"
        },
        "codeAnalyzer.changeThreshold": {
          "type": "number",
          "default": 0.6,
          "minimum": 0.1,
          "maximum": 1,
          "description": "Umbral de cambio para detectar modificaciones abruptas (0.1 - 1.0)"
        },
        "codeAnalyzer.timeThreshold": {
          "type": "number",
          "default": 1500,
          "minimum": 100,
          "maximum": 10000,
          "description": "Tiempo mínimo entre cambios en milisegundos"
        },
        "codeAnalyzer.minCodeLength": {
          "type": "number",
          "default": 50,
          "minimum": 10,
          "maximum": 500,
          "description": "Longitud mínima de código para considerar el archivo"
        },
        "codeAnalyzer.minSuspiciousLength": {
          "type": "number",
          "default": 40,
          "minimum": 10,
          "maximum": 300,
          "description": "Cantidad mínima de caracteres insertados para evaluar sospecha"
        },
        "codeAnalyzer.minAbruptPasteLength": {
          "type": "number",
          "default": 120,
          "minimum": 40,
          "maximum": 1000,
          "description": "Longitud mínima para considerar una inserción como bloque grande"
        },
        "codeAnalyzer.initializationTime": {
          "type": "number",
          "default": 15000,
          "minimum": 5000,
          "maximum": 60000,
          "description": "Tiempo de gracia inicial por archivo en milisegundos"
        },
        "codeAnalyzer.maxHistoryLength": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 50,
          "description": "Longitud máxima del historial de cambios"
        }
      }
    },
    "keybindings": [
      {
        "command": "codeAnalyzer.startMonitoring",
        "key": "alt+f5",
        "mac": "cmd+f5"
      },
      {
        "command": "codeAnalyzer.stopMonitoring",
        "key": "shift+alt+f5",
        "mac": "shift+cmd+f5"
      },
      {
        "command": "codeAnalyzer.showScore",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s"
      },
      {
        "command": "codeAnalyzer.verifyStatus",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v"
      },
      {
        "command": "codeAnalyzer.interceptPaste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "editorTextFocus"
      },
      {
        "command": "codeAnalyzer.interceptCopy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "editorTextFocus"
      },
      {
        "command": "codeAnalyzer.interceptCut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "editorTextFocus"
      },
      {
        "command": "codeAnalyzer.acceptSuggestionTab",
        "key": "tab",
        "when": "editorTextFocus && suggestWidgetVisible"
      },
      {
        "command": "codeAnalyzer.acceptSuggestionEnter",
        "key": "enter",
        "when": "editorTextFocus && suggestWidgetVisible"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/pdfkit": "^0.17.6",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.48.0",
    "@typescript-eslint/parser": "^5.48.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.31.0",
    "typescript": "^4.9.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tu-usuario/code-analyzer-extension.git"
  },
  "license": "MIT",
  "dependencies": {
    "pdfkit": "^0.20.2"
  }
}